# --- Variáveis de Ambiente ---
# Substitua pela URL base da sua API
@baseUrl = http://localhost:3000/api/v1

# Substitua pelo token de autenticação Bearer (se necessário)
# @authToken = Bearer SEU_TOKEN_JWT_AQUI
# Removendo Auth por enquanto para testes locais mais fáceis, descomente e substitua se usar auth
@authToken =

# Substitua por um CUID de ticket válido gerado pelo Prisma após criar um ticket
@ticketId = clvyz12340001abcdefgh5678

# Substitua por um CUID de equipe válido gerado pelo Prisma após criar uma equipe
@teamId = 123

###
# =========================================
# Operações de Tickets (/api/v1/tickets)
# =========================================

###
# @name CreateTicket
# POST /api/v1/tickets/ - Cria um novo chamado
# Cria um novo ticket com as informações fornecidas.
POST {{baseUrl}}/tickets/
Content-Type: application/json
Accept: application/json
Authorization: {{authToken}}

{
  "title": "Problema na Conexão de Rede (Andar 3)",
  "description": "Usuários do terceiro andar estão relatando lentidão extrema na rede desde as 10h.",
  "category": "Rede",
  "location": {
    "address": "Edifício Principal - Terceiro Andar",
    "latitude": -23.550520,
    "longitude": -46.633308
  },
  "priority": "CRITICA"
}

###
# @name CreateTicketSoftware
# POST /api/v1/tickets/ - Cria um novo chamado (Software)
# Cria um novo ticket de software.
POST {{baseUrl}}/tickets/
Content-Type: application/json
Accept: application/json
Authorization: {{authToken}}

{
  "title": "Erro ao Abrir Planilha no Setor Financeiro",
  "description": "O software de planilha fecha inesperadamente ao tentar abrir arquivos grandes.",
  "category": "Software",
  "location": {
    "address": "Edifício Anexo - Setor Financeiro"
  },
  "priority": "ALTA"
}


###
# @name ListTicketsBasic
# GET /api/v1/tickets/ - Lista chamados (página 1, limite 10)
# Busca a primeira página de chamados com o limite padrão.
GET {{baseUrl}}/tickets/
Accept: application/json

###
# @name ListTicketsFilteredStatusPriority
# GET /api/v1/tickets/ - Lista chamados filtrados por status e prioridade
# Busca chamados pendentes com prioridade crítica.
GET {{baseUrl}}/tickets/?status=PENDENTE&priority=CRITICA
Accept: application/json
Authorization: {{authToken}}

###
# @name ListTicketsFilteredCategoryLocation
# GET /api/v1/tickets/ - Lista chamados filtrados por categoria e localização (busca no endereço)
# Busca chamados de 'Software' ocorridos no 'Financeiro'.
GET {{baseUrl}}/tickets/?category=Software&location=Financeiro
Accept: application/json
Authorization: {{authToken}}

###
# @name ListTicketsSortedByPriority
# GET /api/v1/tickets/ - Lista chamados ordenados por Prioridade (Desc)
# Busca chamados ordenados pela prioridade (mais altas primeiro).
GET {{baseUrl}}/tickets/?sortBy=priority&sortOrder=desc&limit=5
Accept: application/json
Authorization: {{authToken}}

###
# @name ListTicketsSortedByUpdate
# GET /api/v1/tickets/ - Lista chamados ordenados por Atualização (Desc)
# Busca chamados ordenados pela data de atualização (mais recentes primeiro).
GET {{baseUrl}}/tickets/?sortBy=updatedAt&sortOrder=desc&limit=5
Accept: application/json
Authorization: {{authToken}}

###
# @name ListTicketsRecentForHome
# GET /api/v1/tickets/ - Lista chamados recentes para a home
# Busca chamados recentes (flag 'recent'). Deverá retornar formato resumido.
GET {{baseUrl}}/tickets/?recent=true
Accept: application/json
Authorization: {{authToken}}

###
# @name GetTicketById
# GET /api/v1/tickets/{ticketId} - Busca um chamado pelo ID (protocolo)
# Busca os detalhes completos de um ticket específico usando seu CUID.
# ** Certifique-se que a variável @ticketId está definida com um CUID válido **
GET {{baseUrl}}/tickets/{{ticketId}}
Accept: application/json
Authorization: {{authToken}}

###
# @name UpdateTicketPartial
# PATCH /api/v1/tickets/{ticketId} - Atualiza parcialmente um chamado
# Modifica o status e a descrição de um ticket existente.
# ** Certifique-se que a variável @ticketId está definida com um CUID válido **
PATCH {{baseUrl}}/tickets/{{ticketId}}
Content-Type: application/json
Accept: application/json
Authorization: {{authToken}}

{
  "status": "EM_ANDAMENTO",
  "description": "Atualização: Técnico João foi verificar o problema de rede no terceiro andar."
}

###
# @name UpdateTicketPriority
# PATCH /api/v1/tickets/{ticketId} - Atualiza parcialmente um chamado (apenas prioridade)
# Modifica apenas a prioridade de um ticket existente.
# ** Certifique-se que a variável @ticketId está definida com um CUID válido **
PATCH {{baseUrl}}/tickets/{{ticketId}}
Content-Type: application/json
Accept: application/json
Authorization: {{authToken}}

{
  "priority": "MEDIA"
}

###
# @name UpdateTicketLocation
# PATCH /api/v1/tickets/{ticketId} - Atualiza parcialmente um chamado (localização)
# Modifica a localização de um ticket existente.
# ** Certifique-se que a variável @ticketId está definida com um CUID válido **
PATCH {{baseUrl}}/tickets/{{ticketId}}
Content-Type: application/json
Accept: application/json
Authorization: {{authToken}}

{
  "location": {
    "address": "Edifício Principal - Terceiro Andar - Sala 305",
    "latitude": -23.550600,
    "longitude": -46.633400
  }
}


###
# @name AssignTicketToTeam
# POST /api/v1/tickets/{ticketId}/assign - Atribui um chamado a uma equipe
# Atribui o ticket especificado para a equipe especificada. Deverá mudar o status para EM_ANDAMENTO.
# ** Certifique-se que as variáveis @ticketId e @teamId estão definidas com CUIDs válidos **
POST {{baseUrl}}/tickets/{{ticketId}}/assign
Content-Type: application/json
Accept: application/json
Authorization: {{authToken}}

{
  "teamId": "{{teamId}}"
}

###
# @name UnassignTicketFromTeam
# PATCH /api/v1/tickets/{ticketId} - Desatribui uma equipe de um chamado
# Remove a atribuição da equipe de um ticket setando assignedTeamId para null.
# ** Certifique-se que a variável @ticketId está definida com um CUID válido **
PATCH {{baseUrl}}/tickets/{{ticketId}}
Content-Type: application/json
Accept: application/json
Authorization: {{authToken}}

{
  "assignedTeamId": null,
  "status": "PENDENTE"
}

###
# @name ResolveTicket
# PATCH /api/v1/tickets/{ticketId} - Resolve um chamado
# Marca um ticket como RESOLVIDO. O campo resolvedAt deve ser preenchido automaticamente.
# ** Certifique-se que a variável @ticketId está definida com um CUID válido **
PATCH {{baseUrl}}/tickets/{{ticketId}}
Content-Type: application/json
Accept: application/json
Authorization: {{authToken}}

{
  "status": "RESOLVIDO"
}

###
# @name GetNonExistentTicket
# GET /api/v1/tickets/{ticketId} - Tenta buscar um chamado inexistente
# Deve retornar um erro 404 Not Found.
# ** Use um CUID que você sabe que não existe **
GET {{baseUrl}}/tickets/clxqz00000000xxxxxxxxxxxxxx
Accept: application/json
Authorization: {{authToken}}

###